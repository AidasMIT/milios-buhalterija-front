# Development: where the Vite dev server proxies /api (the .NET API from milios-buhalterija-back).
API_PROXY_TARGET=http://localhost:5285

# Production build: leave empty when the SPA and the API share one origin (recommended, e.g. a reverse proxy
# serving /api). Set it only when the API runs on a sub-domain of the same site, e.g. https://api.example.lt
VITE_API_URL=
